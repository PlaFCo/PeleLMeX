#---------------------- DOMAIN DEFINITION ------------------------
geometry.is_periodic = 0 0                  # For each dir, 0: non-perio, 1: periodic
geometry.coord_sys   = 0                    # 0 => cart, 1 => RZ
geometry.prob_lo     =  0.00    0.00        # x_lo y_lo (z_lo)
geometry.prob_hi     =   0.24    0.06        # x_hi y_hi (z_hi)

#---------------------- BC FLAGS ---------------------------------
# Interior, Inflow, Outflow, Symmetry,
# SlipWallAdiab, NoSlipWallAdiab, SlipWallIsotherm, NoSlipWallIsotherm
peleLM.lo_bc = Outflow           NoSlipWallAdiab    # bc in x_lo y_lo (z_lo)
peleLM.hi_bc = Inflow        NoSlipWallAdiab    # bc in x_hi y_hi (z_hi)

#--------------------1- AMR CONTROL ------------------------------
amr.n_cell          = 256 64               # Level 0 number of cells in each direction 
amr.v               = 2                     # AMR verbose
amr.max_level       = 5                     # maximum level number allowed
amr.ref_ratio       = 2 2 2 2               # refinement ratio
amr.regrid_int      = 5                     # how often to regrid
amr.n_error_buf     = 2 2 2 2               # number of buffer cells in error est
amr.grid_eff        = 0.7                   # what constitutes an efficient grid
amr.blocking_factor = 16                    # block factor in grid generation (min box size)
amr.max_grid_size   = 32                   # max box size

#---------------------- Problem ----------------------------------
prob.P_mean  = 101325.0
prob.T_init = 300.0  # for init data
prob.is_reactive = false
prob.phi = 0.0
prob.T_hot = 1800.0
prob.EBinflow_pmain = -4.53 # ub 10.2 for cold Luuk case --> see script.py
prob.EBinflow_pcore = -8.0 # ub 10.2 for cold Luuk case --> see script_core.py
prob.EBinflow_T  = 300.0
prob.EB_isoTwall = 300.0
prob.turb_mag = 0.05
prob.has_coreflow = true # IF NO COREFLOW AND I PUT A WALL --> PUT THIS TO FALSE OTHERWISE TROUBLE 

#---------------------- PeleLM CONTROL ---------------------------
peleLM.v = 1                                # PeleLMeX verbose
peleLM.use_wbar = 1                         # Include Wbar term in species diffusion fluxes
peleLM.sdc_iterMax = 2                      # Number of SDC iterations
peleLM.num_init_iter = 3                    # Number of initial iterations
peleLM.floor_species = 0                    # Enforce species positivity (non-conservative !)            
peleLM.deltaT_verbose = 0                   # [OPT, DEF=0] Verbose of the deltaT iterative solve algorithm
peleLM.deltaT_crashIfFailing = 1            # prevent the code from crashing if deltaT iter does not converge
                                            # can happen if issues with non continuous Thermo
peleLM.deltaT_tol = 1e-10
peleLM.advection_scheme="Godunov_PLM"
peleLM.closed_chamber = 0

#peleLM.les_model = "WALE"
#peleLM.les_cm_wale = 0.60
#peleLM.les_v = 0
#---------------------- Temporal CONTROL -------------------------
peleLM.do_temporals = 1                     # Turn temporals ON/OFF
peleLM.temporal_int = 10                    # Frequency of temporals
peleLM.do_extremas = 1                      # Compute state extremas
peleLM.do_mass_balance = 1                  # Compute mass balance
peleLM.do_species_balance = 1               # Compute species balance

#---------------------- Time Stepping CONTROL --------------------
amr.max_step = 35000 #1000000                    # Maximum number of time steps
amr.stop_time = 0.35                      # final simulation physical time - 0.11s of time
amr.cfl = 0.7                             # CFL number for hyperbolic system
amr.dt_shrink = 0.01                       # Scale back initial timestep
amr.dt_change_max = 1.1                   # Maximum dt increase btw successive steps
 
#---------------------- IO CONTROL -------------------------------
amr.restart = chk10000                         # Restart checkpoint file -- 0.24s 
amr.check_int = 250                          # Frequency of checkpoint output(timesteps)
#amr.check_per = 2500                          # Frequency of checkpoint output(simulation time)
amr.plot_int = 200                             # Frequency of pltfile output
#amr.plot_per = 0.0002941                          # Frequency of pltfile output
amr.derive_plot_vars = avg_pressure mag_vort mixture_fraction kinetic_energy temp mag_vel


#---------------------- Reactor CONTROL --------------------------
peleLM.chem_integrator = "ReactorNull"
peleLM.use_typ_vals_chem = 1                # Use species/temp typical values in CVODE
ode.clean_init_massfrac = 0                 # Reaction computed as an increment
ode.rtol = 1.0e-6                           # Relative tolerance of the chemical solve
ode.atol = 1.0e-5                           # Absolute tolerance factor applied on typical values
cvode.solve_type = denseAJ_direct           # CVODE Linear solve type (for Newton direction) 
cvode.max_order  = 4                        # CVODE max BDF order. 

#---------------------- EB SETUP ---------------------------------
#eb2.box_lo =    -0.01    0.066
#eb2.box_hi =     0.042   0.070
#eb2.box_has_fluid_inside = 0
eb2.geom_type = UserDefined
eb2.sharp = true
eb2.maxiter = 500
eb2.num_coarsen_opt=2    # EB generation hack
eb2.max_grid_size=64
eb2.small_volfrac = 1.0e-4
peleLM.isothermal_EB = 1
peleLM.EBinflow = 1

#---------------------- Linear solver CONTROL --------------------
nodal_proj.verbose = 0                      # Nodal projection verbose
mac_proj.verbose = 0                        # MAC projection verbose
mac_proj.rtol = 1.0e-8                     # [OPT, DEF=1e-11] Relative tolerance of the MAC projection
mac_proj.atol = 1.0e-8

#diffusion.verbose = 2
nodal_proj.rtol = 1e-8
nodal_proj.atol = 1e-8
# ------------------- INPUTS DERIVED DIAGS ------------------
peleLM.fuel_name = H2
peleLM.mixtureFraction.format = Cantera
peleLM.mixtureFraction.type   = mass
peleLM.mixtureFraction.oxidTank = O2:0.233 N2:0.767
peleLM.mixtureFraction.fuelTank = H2:1.0
#peleLM.progressVariable.format = Cantera
#peleLM.progressVariable.weights = CO:1.0 CO2:1.0
#peleLM.progressVariable.coldState = CO:0.0 CO2:0.0
#peleLM.progressVariable.hotState = CO:0.000002 CO2:0.0666

#---------------------- Refinement CONTROL------------------------
peleLM.refine_EB_type = Static
peleLM.refine_EB_max_level = 3
peleLM.refine_EB_buffer = 2.0

amr.refinement_indicators = box_top1 box_top2 box_bottom1 box_bottom2 mgvort

# 2 is bottom wall , 1 is top wall

amr.box_top2.max_level = 3
amr.box_top2.in_box_lo = 0.040 0.050 0.000
amr.box_top2.in_box_hi = 0.197 0.051 0.031

amr.box_top1.max_level = 3
amr.box_top1.in_box_lo = 0.040 0.059 0.000
amr.box_top1.in_box_hi = 0.202 0.060 0.031

amr.box_bottom2.max_level = 3
amr.box_bottom2.in_box_lo = 0.172 0.000 0.000
amr.box_bottom2.in_box_hi = 0.240  0.001 0.031

amr.box_bottom1.max_level = 3
amr.box_bottom1.in_box_lo = 0.172 0.011 0.000
amr.box_bottom1.in_box_hi = 0.24  0.012 0.031

amr.mgvort.max_level     = 3
amr.mgvort.value_greater = 12000.0
amr.mgvort.field_name    = mag_vort
#amr.IR1.max_level      = 4
#amr.IR1.value_greater  = 0.06 
#amr.IR1.field_name     = I_R(H2O2)

#---------------------- Debug/HPC CONTROL-------------------------
#amrex.fpe_trap_invalid = 1
#amrex.fpe_trap_zero = 1
#amrex.fpe_trap_overflow = 1
